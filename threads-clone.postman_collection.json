            "url": {
              "raw": "{{base_url}}/api/users/1/followers",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "1", "followers"]
            }
          }
        },
        {
          "name": "Get User Following",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/1/following",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "1", "following"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
